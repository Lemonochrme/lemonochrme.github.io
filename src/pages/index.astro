---
import { Picture, getImage } from 'astro:assets';
import Aerolith from '../layouts/Aerolith.astro';
import redline from '../../aerolith-galery/Lithframe_Bezier_01_Redline_4K.png';
import obsidian from '../../aerolith-galery/Lithframe_Bezier_02_Obsidian_4K.png';
import powertrain from '../../aerolith-galery/Lithframe_Bezier_03_Powertrain_4K.png';
import exploded from '../../aerolith-galery/Lithframe_Bezier_04_Exploded_4K.png';
import service from '../../aerolith-galery/Lithframe_Bezier_05_Service_4K.png';
import silhouette from '../../aerolith-galery/Lithframe_Bezier_06_Silhouette_4K.png';
import flightController from '../../aerolith-galery/Lithframe_Bezier_07_FC_4K.png';
import windings from '../../aerolith-galery/Lithframe_Bezier_08_Windings_4K.png';
import harness from '../../aerolith-galery/Lithframe_Bezier_09_Harness_4K.png';
import lithcore from '../../public/data/aerolith/lithcore.json';
import lithdrive from '../../public/data/aerolith/lithdrive.json';

// Hero : rendu plein cadre en haute résolution, recadré différemment selon le format.
const srcset = async (image: ImageMetadata, widths: number[], format: 'avif' | 'webp') =>
  (await Promise.all(widths.map((w) => getImage({ src: image, width: w, format, quality: format === 'avif' ? 62 : 74 }))))
    .map((r, k) => `${r.src} ${widths[k]}w`)
    .join(', ');
const heroWide = { avif: await srcset(redline, [1280, 1920, 2560, 3200], 'avif'), webp: await srcset(redline, [1280, 1920, 2560], 'webp') };
const heroTall = { avif: await srcset(exploded, [800, 1200, 1600], 'avif'), webp: await srcset(exploded, [800, 1200, 1600], 'webp') };
const heroFallback = await getImage({ src: redline, width: 1920, format: 'webp', quality: 74 });

// Chaque planche a une petite version pour générer son ASCII.
const plate = async (image: ImageMetadata, title: string, n: string, span = '') => ({
  image,
  title,
  n,
  span,
  ascii: (await getImage({ src: image, width: 320, format: 'webp', quality: 60 })).src,
});
const fcPlate = await plate(flightController, 'LithCore Rev A, populated', 'Fig. 03');
const explodedPlate = await plate(exploded, 'Exploded assembly', 'Fig. 02');
const windingsPlate = await plate(windings, 'Stator, 12 slots', 'Fig. 04');
const plates = await Promise.all([
  plate(silhouette, 'Silhouette', 'Pl. 01', 'a'),
  plate(powertrain, 'Powertrain', 'Pl. 02', 'b'),
  plate(service, 'Service access', 'Pl. 03', 'c'),
  plate(harness, 'Harness routing', 'Pl. 04', 'd'),
  plate(obsidian, 'Obsidian', 'Pl. 05', 'e'),
]);

const fc = lithcore.stats;
const esc = lithdrive.stats;

const mark =
  'M-6.95 6.1L-.66-6.03Q-.45-6.4-.24-6.06L6.71 3.07Q6.8 3.4 6.49 3.47L-.48 2.74-6.6 6.43Q-7.05 6.5-6.95 6.1Z';

const status = [
  { group: 'Power', name: 'LithDrive 3S', note: 'Validated on Nanolith', s: [2, 2, 2, 2] },
  { group: '', name: 'LithDrive 6S', note: 'Rev A fabricated, awaiting parts', s: [2, 2, 0, 0] },
  { group: 'Avionics', name: 'LithCore Rev A', note: 'USB, SWD, OSD, flash up', s: [2, 2, 2, 1] },
  { group: '', name: 'LithCore Rev B', note: 'Errata closed, AIO study', s: [1, 0, 0, 0] },
  { group: 'Airframe', name: 'Lithframe V1', note: 'Acrylic, 330 mm', s: [2, 2, 2, 0] },
  { group: '', name: 'Lithframe F380', note: 'Carbon cut files ready', s: [2, 1, 0, 0] },
  { group: 'Firmware', name: 'Drivers', note: 'C, FreeRTOS', s: [2, 1, 0, 0] },
  { group: '', name: 'ELRS link', note: 'Library in progress', s: [2, 1, 0, 0] },
  { group: '', name: 'Attitude control', note: 'Not started', s: [0, 0, 0, 0] },
];
const stages = ['Design', 'Build', 'Bring-up', 'Validated'];
const glyph = ['·', '■', '■'];
const scopeSteps = ['Parts', 'Top', 'In1', 'In2', 'Bot', 'Trace'];
---

<Aerolith
  title="Aerolith — Heavy-lift cinema quadcopter"
  description="Aerolith: a heavy-lift cinema quadcopter. Carbon airframe, flight controller, ESCs and firmware designed in-house."
>
  <header class="bar">
    <a class="bar-mark" href="#top" aria-label="Aerolith, back to top">
      <svg viewBox="-7.5 -7 15 14" aria-hidden="true"><path d={mark} /></svg>
      <span>Aerolith</span>
    </a>
    <nav class="bar-nav" aria-label="Sections">
      <a href="#frame" data-nav="frame" data-scramble><i>01</i>Frame</a>
      <a href="#lithcore" data-nav="lithcore" data-scramble><i>02</i>LithCore</a>
      <a href="#lithdrive" data-nav="lithdrive" data-scramble><i>03</i>LithDrive</a>
      <a href="#status" data-nav="status" data-scramble><i>04</i>Status</a>
    </nav>
    <span class="bar-now" aria-hidden="true"></span>
    <a class="bar-out" href="/archive" data-scramble>Logs <span aria-hidden="true">↗</span></a>
    <span class="bar-progress" aria-hidden="true"></span>
  </header>

  <main id="top">
    <!-- 00 — Hero -->
    <section class="hero" aria-label="Aerolith">
      <picture class="hero-media">
        <source media="(max-width: 760px) and (orientation: portrait)" type="image/avif" srcset={heroTall.avif} sizes="100vw" />
        <source media="(max-width: 760px) and (orientation: portrait)" type="image/webp" srcset={heroTall.webp} sizes="100vw" />
        <source type="image/avif" srcset={heroWide.avif} sizes="100vw" />
        <source type="image/webp" srcset={heroWide.webp} sizes="100vw" />
        <img src={heroFallback.src} alt="Aerolith on the ground, lit by a red light strip" fetchpriority="high" decoding="async" />
      </picture>
      <div class="hero-ui">
        <p class="hero-fig mono">Fig. 01 — Lithframe F380, render</p>
        <h1 class="wordmark">
          <span class="sr-only">Aerolith</span>
          <span class="wordmark-fallback" aria-hidden="true">AEROLITH</span>
          <canvas aria-hidden="true"></canvas>
        </h1>
        <dl class="hero-meta mono">
          <div><dt>Type</dt><dd>Heavy-lift cinema quadcopter</dd></div>
          <div><dt>Payload</dt><dd>Full-frame, A7S III class</dd></div>
          <div><dt>Frame</dt><dd>Carbon, 380 mm</dd></div>
          <div><dt>Motors</dt><dd>3115 640KV, 6S</dd></div>
          <div><dt>Props</dt><dd>9 × 5 × 3</dd></div>
          <div><dt>Stage</dt><dd><b class="dot"></b>In development</dd></div>
        </dl>
      </div>
    </section>

    <section class="thesis">
      <p class="thesis-line">
        A heavy-lift quadcopter for full-frame cinema cameras. Frame, flight controller, ESCs and firmware are designed
        in-house.
      </p>
      <div class="thesis-aside mono">
        <p>Designed, assembled and brought up by two engineers from INSA Toulouse.</p>
      </div>
      <ol class="stack mono" aria-label="System layers">
        <li><a href="#frame" data-scramble><i>01</i><span>Airframe</span><em>Lithframe F380</em></a></li>
        <li><a href="#lithcore" data-scramble><i>02</i><span>Flight controller</span><em>LithCore</em></a></li>
        <li><a href="#lithdrive" data-scramble><i>03</i><span>ESC</span><em>LithDrive 6S</em></a></li>
        <li><a href="#status" data-scramble><i>04</i><span>Firmware</span><em>C / FreeRTOS</em></a></li>
      </ol>
    </section>

    <!-- 01 — Châssis -->
    <section id="frame" class="chapter" data-section="frame">
      <header class="chapter-head">
        <span class="chapter-n mono">01</span>
        <h2><span class="chapter-kicker mono" data-decode>Airframe</span><span data-decode>Lithframe F380</span></h2>
        <p class="chapter-lede">Carbon plates and truss arms on M3 standoffs. 380 mm motor to motor.</p>
      </header>

      <div class="frame3d" data-model="/data/aerolith/chassis.json" data-bin="/data/aerolith/chassis.bin">
        <div class="frame-sticky">
          <div class="frame-head mono">
            <span>Assembly — <output data-out="stage">Assembly</output></span>
            <span class="frame-hint">Drag to rotate</span>
          </div>
          <div class="frame-stage">
            <canvas class="frame-gl" aria-label="Lithframe F380 assembly, 34 parts, rendered as text"></canvas>
            <span class="callout mono" data-callout="Platine_superieure">Plate ×2<small>270 × 126</small></span>
            <span class="callout mono" data-callout="Bras_Long_D_AV">Long arm ×4<small>190 × 28</small></span>
            <span class="callout mono" data-callout="Bras_Court_G_AV">Short arm ×4<small>160 × 28</small></span>
            <span class="callout mono" data-callout="Support_moteur_Haut_D_AR">Motor mount ×8<small>61 × 47</small></span>
            <span class="callout mono" data-callout="Entretoise_M3_10_G_AR">Standoff M3 ×16</span>
            <span class="tick tl"></span><span class="tick tr"></span><span class="tick bl"></span><span class="tick br"></span>
          </div>
          <div class="frame-read mono" aria-hidden="true">
            <div><span>Parts</span><b><output data-out="count">00</output> / 34</b></div>
            <div><span>Envelope</span><b>339 × 328 × 28 mm</b></div>
            <div><span>Source</span><b>FreeCAD assembly</b></div>
          </div>
        </div>
      </div>

      <div class="frame-detail">
        <div class="frame-specs">
          <table class="parts mono">
            <caption>Bill of parts</caption>
            <thead><tr><th>Part</th><th>Envelope</th><th>Qty</th></tr></thead>
            <tbody>
              <tr><td>Plate</td><td>270 × 126 mm</td><td>2</td></tr>
              <tr><td>Long arm</td><td>190 × 28 mm</td><td>4</td></tr>
              <tr><td>Short arm</td><td>160 × 28 mm</td><td>4</td></tr>
              <tr><td>Motor mount</td><td>61 × 47 mm</td><td>8</td></tr>
              <tr><td>Standoff M3</td><td>—</td><td>16</td></tr>
            </tbody>
          </table>
          <dl class="spec mono">
            <div><dt>Motors</dt><dd>4 × 3115, 640KV</dd></div>
            <div><dt>Props</dt><dd>9 × 5, three-blade</dd></div>
            <div><dt>Bus</dt><dd>6S</dd></div>
            <div><dt>FC mount</dt><dd>30.5 × 30.5 mm</dd></div>
          </dl>
        </div>
        <figure class="plate plate-exploded" data-ascii={explodedPlate.ascii}>
          <Picture src={exploded} alt="Exploded view of the Aerolith assembly" widths={[640, 960, 1400]} sizes="(min-width: 900px) 58vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={50} loading="lazy" />
          <canvas aria-hidden="true"></canvas>
          <figcaption class="mono"><span>{explodedPlate.n}</span>{explodedPlate.title}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 — Contrôleur de vol -->
    <section id="lithcore" class="chapter" data-section="lithcore">
      <header class="chapter-head">
        <span class="chapter-n mono">02</span>
        <h2><span class="chapter-kicker mono" data-decode>Flight controller</span><span data-decode>LithCore</span></h2>
        <p class="chapter-lede">STM32F405 flight controller. Four layers, 38 × 38 mm.</p>
      </header>

      <div class="scope scope-square" data-svg="/data/aerolith/lithcore.svg" data-meta="/data/aerolith/lithcore.json" data-height="/data/aerolith/lithcore-h.bin" data-hmeta="/data/aerolith/lithcore-h.json">
        <div class="scope-sticky">
          <div class="scope-head mono">
            <ol class="steps" aria-label="Views">
              {scopeSteps.map((s, k) => <li><button data-step={k} aria-current={k === 0 ? 'true' : 'false'}><i>{String(k + 1).padStart(2, '0')}</i>{s}</button></li>)}
            </ol>
            <div class="readout" aria-live="polite"><b data-out="name">—</b><em data-out="info"></em></div>
          </div>
          <div class="pcb-stage">
            <canvas aria-label="LithCore layout rendered as text: components, copper layers and one traced net"></canvas>
            <div class="pcb-labels mono" aria-hidden="true"></div>
          </div>
          <p class="board-dim mono"><span data-out="stage">Components</span><span>{fc.w} × {fc.h} mm</span><span>4 layers</span><span>{fc.components} parts</span><span>{fc.vias} vias</span></p>
        </div>
      </div>

      <div class="board-specs">
        <dl class="spec mono">
          <div><dt>MCU</dt><dd>STM32F405RGT6<small>Cortex-M4F, 168 MHz</small></dd></div>
          <div><dt>IMU</dt><dd>ICM-42688-P<small>SPI1, dedicated chip select</small></dd></div>
          <div><dt>Baro</dt><dd>LPS22HH</dd></div>
          <div><dt>OSD</dt><dd>AT7456E<small>Analog video in / out</small></dd></div>
          <div><dt>Log</dt><dd>W25Q128JV<small>128 Mbit blackbox flash</small></dd></div>
          <div><dt>Power</dt><dd>LMR51430 buck, TPS7A20 LDO<small>USB / battery OR-ing</small></dd></div>
          <div><dt>I/O</dt><dd>USB-C, 5 UART, I²C, SWD<small>8 motor outputs</small></dd></div>
        </dl>
        <div class="errata-list">
          <h3 class="mono" data-decode>Rev A — bring-up</h3>
          <ol class="mono">
            <li><span>E1</span>VDDA left unconnected from 3V3. Bridged across two decoupling capacitors.</li>
            <li><span>E2</span>BOOT0 button footprint open. DFU forced with a solder bridge.</li>
            <li><span>E3</span>IMU sourced as clone parts. Driver rewritten against the actual register map.</li>
          </ol>
          <p class="note">Board runs firmware over USB and SWD. Both layout errata are closed for Rev B.</p>
        </div>
      </div>
      <figure class="plate plate-fc" data-ascii={fcPlate.ascii}>
        <Picture src={flightController} alt="LithCore flight controller, populated board" widths={[640, 960, 1400, 1920]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={50} loading="lazy" />
        <canvas aria-hidden="true"></canvas>
        <figcaption class="mono"><span>{fcPlate.n}</span>{fcPlate.title}</figcaption>
      </figure>
    </section>

    <!-- 03 — ESC -->
    <section id="lithdrive" class="chapter" data-section="lithdrive">
      <header class="chapter-head">
        <span class="chapter-n mono">03</span>
        <h2><span class="chapter-kicker mono" data-decode>ESC</span><span data-decode>LithDrive 6S</span></h2>
        <p class="chapter-lede">Sensorless three-phase ESC for a 6S bus. Four layers, 49.4 × 23.8 mm.</p>
      </header>

      <div class="scope scope-wide" data-svg="/data/aerolith/lithdrive.svg" data-meta="/data/aerolith/lithdrive.json" data-height="/data/aerolith/lithdrive-h.bin" data-hmeta="/data/aerolith/lithdrive-h.json">
        <div class="scope-sticky">
          <div class="scope-head mono">
            <ol class="steps" aria-label="Views">
              {scopeSteps.map((s, k) => <li><button data-step={k} aria-current={k === 0 ? 'true' : 'false'}><i>{String(k + 1).padStart(2, '0')}</i>{s}</button></li>)}
            </ol>
            <div class="readout" aria-live="polite"><b data-out="name">—</b><em data-out="info"></em></div>
          </div>
          <div class="pcb-stage">
            <canvas aria-label="LithDrive 6S layout rendered as text: components, copper layers and one traced net"></canvas>
            <div class="pcb-labels mono" aria-hidden="true"></div>
          </div>
          <p class="board-dim mono"><span data-out="stage">Components</span><span>{esc.w} × {esc.h} mm</span><span>4 layers</span><span>{esc.components} parts</span><span>{esc.vias} vias</span></p>
        </div>
      </div>

      <dl class="spec spec-row mono">
        <div><dt>MCU</dt><dd>STM32F051C8T6<small>AM32-compatible</small></dd></div>
        <div><dt>Gate drive</dt><dd>DRV8300<small>Bootstrap high side</small></dd></div>
        <div><dt>Bridge</dt><dd>6 × XRS200N06HF<small>N-channel MOSFET</small></dd></div>
        <div><dt>Supply</dt><dd>LM5164 buck, AMS1117<small>VBAT → 10 V → 3V3</small></dd></div>
        <div><dt>Sensing</dt><dd>BEMF A / B / C<small>Divider + common node</small></dd></div>
      </dl>

      <div class="lineage">
        <div class="lineage-text">
          <h3 class="mono" data-decode>Iterations</h3>
          <p>Several iterations led to the current design. It is still in development.</p>
        </div>
        <figure class="plate plate-windings" data-ascii={windingsPlate.ascii}>
          <Picture src={windings} alt="Motor stator with copper windings" widths={[640, 960, 1400]} sizes="(min-width: 900px) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={50} loading="lazy" />
          <canvas aria-hidden="true"></canvas>
          <figcaption class="mono"><span>{windingsPlate.n}</span>{windingsPlate.title}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 04 — Statut -->
    <section id="status" class="chapter" data-section="status">
      <header class="chapter-head">
        <span class="chapter-n mono">04</span>
        <h2><span class="chapter-kicker mono" data-decode>Program</span><span data-decode>Status</span></h2>
        <p class="chapter-lede">Where each subsystem stands, from the build logs.</p>
      </header>
      <div class="matrix mono" role="table" aria-label="Subsystem status">
        <div class="m-row m-head" role="row">
          <span role="columnheader">System</span>
          {stages.map((s) => <span role="columnheader" class="m-stage">{s}</span>)}
          <span role="columnheader" class="m-note">Note</span>
        </div>
        {status.map((r) => (
          <div class:list={['m-row', { 'm-group': r.group }]} role="row">
            <span role="cell" class="m-name"><i>{r.group}</i>{r.name}</span>
            {r.s.map((v, k) => (
              <span role="cell" class:list={['m-cell', `v${v}`]} aria-label={`${stages[k]}: ${['not started', 'in progress', 'done'][v]}`}>{glyph[v]}</span>
            ))}
            <span role="cell" class="m-note">{r.note}</span>
          </div>
        ))}
      </div>
      <p class="legend mono"><span><b class="v2">■</b> Done</span><span><b class="v1">■</b> In progress</span><span><b class="v0">·</b> Not started</span></p>
    </section>

    <section class="plates" aria-label="Renders">
      <header class="plates-head mono"><span data-decode>Plates</span><span>Cycles renders of the F380 assembly</span></header>
      <div class="plates-grid">
        {plates.map((p) => (
          <figure class:list={['plate', `plate-${p.span}`]} data-ascii={p.ascii}>
            <Picture src={p.image} alt={`Aerolith, ${p.title.toLowerCase()}`} widths={[640, 960, 1400, 1920]} sizes="(min-width: 900px) 66vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={50} loading="lazy" />
            <canvas aria-hidden="true"></canvas>
            <figcaption class="mono"><span>{p.n}</span>{p.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>

  <footer class="foot">
    <p class="foot-line">Open hardware. Schematics, layouts and firmware are released at first flight.</p>
    <div class="foot-cols mono">
      <div>
        <h3>Build logs</h3>
        <a href="/posts/2026-04-11-aerolith" data-scramble>Aerolith, status update</a>
        <a href="/posts/2026-05-01-fc" data-scramble>LithCore flight controller</a>
        <a href="/posts/2026-02-15-bldc-esc" data-scramble>LithDrive sensorless ESC</a>
      </div>
      <div>
        <h3>Portfolio</h3>
        <a href="/archive" data-scramble>Posts</a>
        <a href="/about" data-scramble>About</a>
        <a href="/resume" data-scramble>Resume</a>
      </div>
      <div class="foot-sign">
        <svg viewBox="-7.5 -7 15 14" aria-hidden="true"><path d={mark} /></svg>
        <span>© {new Date().getFullYear()} Robin Marin--Muller</span>
      </div>
    </div>
  </footer>

  <script>
    import { initWordmark } from '../scripts/aerolith/wordmark';
    import { initFrame } from '../scripts/aerolith/frame3d';
    import { initScope } from '../scripts/aerolith/scope';
    import { initPlates, initDecode, initScramble } from '../scripts/aerolith/plates';
    import { whenNear } from '../scripts/aerolith/glyphs';

    initWordmark(document.querySelector<HTMLElement>('.wordmark')!);
    const frame = document.querySelector<HTMLElement>('.frame3d')!;
    whenNear(frame, () => initFrame(frame).catch(() => frame.classList.add('is-fallback')), '100%');
    document.querySelectorAll<HTMLElement>('.scope').forEach((s) => initScope(s));
    initPlates();
    initDecode();
    initScramble();

    // Barre : section courante et progression de lecture.
    const now = document.querySelector<HTMLElement>('.bar-now')!;
    const links = new Map([...document.querySelectorAll<HTMLElement>('[data-nav]')].map((a) => [a.dataset.nav!, a]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const a = links.get((e.target as HTMLElement).dataset.section!);
          if (!a) continue;
          a.classList.toggle('is-current', e.isIntersecting);
          if (e.isIntersecting) now.innerHTML = a.innerHTML;
          else if (now.innerHTML === a.innerHTML) now.innerHTML = '';
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('[data-section]').forEach((s) => io.observe(s));
    const bar = document.querySelector<HTMLElement>('.bar')!;
    const prog = document.querySelector<HTMLElement>('.bar-progress')!;
    let raf = 0;
    const onScroll = () => {
      raf = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      prog.style.transform = `scaleX(${scrollY / Math.max(max, 1)})`;
      bar.classList.toggle('is-solid', scrollY > innerHeight * 0.6);
    };
    addEventListener('scroll', () => raf || (raf = requestAnimationFrame(onScroll)), { passive: true });
    onScroll();
  </script>
</Aerolith>

<style>
  .mono {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ───── Barre ───── */
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--bar);
    padding: 0 var(--m);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background-color 0.4s, border-color 0.4s;
    border-bottom: 1px solid transparent;
  }

  .bar.is-solid {
    background: rgba(6, 6, 6, 0.94);
    border-bottom-color: var(--line);
  }

  .bar a {
    text-decoration: none;
  }

  .bar-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .bar-mark svg {
    width: 15px;
    height: 14px;
    fill: var(--ink);
    transform: rotate(0deg);
  }

  .bar-nav {
    display: flex;
    gap: clamp(16px, 2.6vw, 40px);
  }

  .bar-nav a {
    color: var(--ink-3);
    transition: color 0.25s;
  }

  .bar-nav a i {
    font-style: normal;
    margin-right: 6px;
    color: var(--ink-4);
  }

  .bar-nav a:hover,
  .bar-nav a.is-current {
    color: var(--ink);
  }

  .bar-nav a.is-current i {
    color: var(--sig);
  }

  .bar-out {
    justify-self: end;
    color: var(--ink-2);
  }

  .bar-out:hover {
    color: var(--ink);
  }

  .bar-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--sig);
    transform-origin: left;
    transform: scaleX(0);
  }

  .bar-now {
    display: none;
  }

  @media (max-width: 760px) {
    .bar-nav {
      display: none;
    }

    .bar-now {
      display: block;
      color: var(--ink);
    }

    .bar-now :global(i) {
      font-style: normal;
      margin-right: 6px;
      color: var(--sig);
    }
  }

  /* ───── Hero ───── */
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--bg);
  }

  .hero-media,
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-media img {
    object-fit: cover;
    object-position: 50% 42%;
    animation: hero-in 1.6s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
  }

  .hero-ui {
    position: absolute;
    inset: auto 0 0;
    padding: 160px var(--m) calc(var(--m) * 0.9);
    background: linear-gradient(to top, rgba(6, 6, 6, 0.92) 30%, rgba(6, 6, 6, 0.55) 62%, rgba(6, 6, 6, 0) 100%);
  }

  .hero-fig {
    margin: 0 0 14px;
    color: var(--ink-3);
  }

  .wordmark {
    position: relative;
    margin: 0 0 clamp(18px, 2.4vw, 32px);
    line-height: 0;
  }

  .wordmark canvas {
    width: 100%;
  }

  .wordmark-fallback {
    display: block;
    font-family: var(--mono);
    font-weight: 300;
    font-size: calc((100vw - 2 * var(--m)) / 4.4);
    line-height: 0.8;
    letter-spacing: -0.07em;
  }

  .wordmark:global(.is-live) .wordmark-fallback {
    display: none;
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--gap);
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .hero-meta div {
    display: grid;
    gap: 2px;
  }

  .hero-meta dt {
    color: var(--ink-3);
  }

  .hero-meta dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 6px;
    height: 6px;
    background: var(--sig);
  }

  @media (max-width: 1100px) {
    .hero-meta {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 14px;
    }
  }

  @media (max-width: 760px) {
    .hero-meta {
      grid-template-columns: 1fr 1fr;
    }

    .hero-ui {
      padding-top: 200px;
      background: linear-gradient(to top, rgba(6, 6, 6, 0.95) 45%, rgba(6, 6, 6, 0) 100%);
    }
  }

  /* ───── Châssis 3D ───── */
  .frame3d {
    height: 340vh;
    margin: 0 calc(var(--m) * -1);
  }

  .frame-sticky {
    position: sticky;
    top: var(--bar);
    height: calc(100vh - var(--bar));
    height: calc(100svh - var(--bar));
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 14px;
    padding: 18px var(--m) 22px;
  }

  .frame-head {
    display: flex;
    justify-content: space-between;
    color: var(--ink-3);
  }

  .frame-head output {
    color: var(--ink);
  }

  .frame-hint {
    color: var(--ink-4);
  }

  .frame-stage {
    position: relative;
    min-height: 0;
    cursor: grab;
    touch-action: pan-y;
  }

  .frame-stage:active {
    cursor: grabbing;
  }

  .frame-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .callout {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    padding: 0 0 0 14px;
    color: var(--ink);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s;
  }

  .callout::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 5px;
    width: 6px;
    height: 6px;
    background: var(--sig);
  }

  .callout small {
    font-size: inherit;
    color: var(--ink-3);
  }

  .callout:global(.is-on) {
    opacity: 1;
  }

  .frame3d:global(.is-fallback) {
    display: none;
  }

  .tick {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 0 solid var(--ink-3);
  }

  .tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }

  .frame-read {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(20px, 4vw, 56px);
  }

  .frame-read div {
    display: flex;
    gap: 10px;
  }

  .frame-read span {
    color: var(--ink-3);
  }

  .frame-read b {
    font-weight: 400;
  }

  @media (max-width: 760px) {
    .frame-sticky {
      grid-template-rows: auto minmax(0, 64svh) auto;
      align-content: center;
    }

    .frame-hint {
      display: none;
    }

    .callout small {
      display: none;
    }
  }

  .frame-detail {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding: clamp(48px, 7vw, 100px) 0 clamp(80px, 11vw, 160px);
    align-items: start;
  }

  .frame-specs {
    grid-column: 1 / span 5;
    display: grid;
    gap: 48px;
  }

  .parts {
    width: 100%;
    border-collapse: collapse;
  }

  .parts caption {
    text-align: left;
    color: var(--ink-3);
    padding-bottom: 14px;
  }

  .parts th {
    text-align: left;
    font-weight: 400;
    color: var(--ink-3);
    padding: 0 0 10px;
    border-bottom: 1px solid var(--line);
  }

  .parts td {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .parts td:not(:first-child),
  .parts th:not(:first-child) {
    text-align: right;
  }

  .plate-exploded {
    grid-column: 7 / span 6;
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 900px) {
    .frame-detail {
      grid-template-columns: 1fr;
    }

    .frame-detail > * {
      grid-column: 1 !important;
    }

    .plate-exploded {
      margin: 40px calc(var(--m) * -1) 0;
      aspect-ratio: 3 / 4;
    }
  }

  /* ───── Scope PCB ───── */
  .scope {
    height: 460vh;
  }

  .scope-sticky {
    position: sticky;
    top: var(--bar);
    min-height: calc(100vh - var(--bar));
    min-height: calc(100svh - var(--bar));
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    gap: 16px;
    padding: 18px 0 22px;
  }

  .scope-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .steps {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
  }

  .steps li + li {
    border-left: 1px solid var(--line);
  }

  .steps button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--ink-3);
    background: none;
    border: 0;
    padding: 7px 11px;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }

  .steps button i {
    font-style: normal;
    margin-right: 6px;
    color: var(--ink-4);
  }

  .steps button:hover {
    color: var(--ink);
  }

  .steps button[aria-current='true'] {
    color: #000;
    background: var(--ink);
  }

  .steps button[aria-current='true'] i {
    color: var(--sig);
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
    white-space: nowrap;
  }

  .readout b {
    font-weight: 400;
    color: var(--sig);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .readout em {
    font-style: normal;
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pcb-stage {
    position: relative;
    align-self: center;
    justify-self: center;
    width: 100%;
  }

  .scope-square .pcb-stage {
    max-width: min(100%, calc(100svh - var(--bar) - 170px));
  }

  .scope-wide .pcb-stage {
    max-width: min(100%, calc((100svh - var(--bar) - 170px) * 2.08));
  }

  .pcb-stage canvas {
    width: 100%;
    cursor: crosshair;
  }

  .pcb-stage :global(.pcb-overlay) {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .pcb-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .scope:global([data-stage='comp']) .pcb-labels {
    opacity: 1;
  }

  .pcb-labels :global(span) {
    position: absolute;
    transform: translate(-50%, -50%);
    padding: 1px 4px;
    background: rgba(6, 6, 6, 0.82);
    color: var(--ink);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .board-dim {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
  }

  .board-dim span:first-child {
    color: var(--ink);
    min-width: 13ch;
  }

  @media (max-width: 760px) {
    .scope {
      height: 420vh;
    }

    .scope-sticky {
      grid-template-rows: auto auto auto;
      align-content: center;
      gap: 22px;
    }

    .scope-head {
      flex-direction: column;
      align-items: stretch;
    }

    .steps button {
      padding: 7px 4px;
      width: 100%;
    }

    .steps li {
      flex: 1;
    }

    .steps button i {
      display: none;
    }

    .scope-wide .pcb-stage {
      width: calc(100% + var(--m));
      max-width: none;
      margin: 0 calc(var(--m) * -0.5);
    }
  }

  .board-specs {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding: clamp(48px, 7vw, 96px) 0 clamp(48px, 7vw, 96px);
    align-items: start;
  }

  .board-specs .spec {
    grid-column: 1 / span 6;
  }

  .board-specs .errata-list {
    grid-column: 8 / span 5;
  }

  .plate-fc {
    aspect-ratio: 21 / 9;
    margin: 0 calc(var(--m) * -1) clamp(80px, 11vw, 160px);
  }

  @media (max-width: 900px) {
    .board-specs {
      grid-template-columns: 1fr;
    }

    .board-specs > * {
      grid-column: 1 !important;
    }

    .board-specs .errata-list {
      margin-top: 32px;
    }

    .plate-fc {
      aspect-ratio: 4 / 5;
    }
  }

  /* ───── Thèse ───── */
  .thesis {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding: clamp(96px, 16vw, 220px) var(--m) clamp(72px, 10vw, 140px);
  }

  .thesis-line {
    grid-column: 1 / span 10;
    margin: 0;
    font-size: clamp(30px, 4.6vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 300;
    text-wrap: balance;
  }

  .thesis-line em {
    font-style: normal;
    color: var(--sig);
  }

  .thesis-aside {
    grid-column: 1 / span 4;
    margin-top: clamp(32px, 5vw, 64px);
    color: var(--ink-3);
  }

  .thesis-aside p {
    margin: 0 0 4px;
  }

  .stack {
    grid-column: 6 / span 7;
    margin: clamp(32px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .stack a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 0.2s, padding 0.3s cubic-bezier(0.2, 0.7, 0.1, 1);
  }

  .stack i {
    font-style: normal;
    color: var(--ink-4);
  }

  .stack em {
    font-style: normal;
    color: var(--ink-3);
  }

  .stack a:hover {
    padding-left: 10px;
  }

  .stack a:hover i {
    color: var(--sig);
  }

  @media (max-width: 760px) {
    .thesis {
      grid-template-columns: 1fr;
    }

    .thesis > * {
      grid-column: 1 !important;
    }

    .stack a {
      grid-template-columns: 36px 1fr auto;
    }
  }

  /* ───── Chapitres ───── */
  .chapter {
    position: relative;
    padding: clamp(80px, 11vw, 160px) var(--m) 0;
    border-top: 1px solid var(--line);
  }

  .chapter-head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    align-items: end;
    margin-bottom: clamp(40px, 6vw, 88px);
  }

  .chapter-n {
    grid-column: 1 / span 2;
    align-self: start;
    color: var(--sig);
  }

  .chapter-head h2 {
    grid-column: 3 / span 6;
    margin: 0;
    font-weight: 300;
    font-size: clamp(44px, 7.4vw, 124px);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .chapter-kicker {
    display: block;
    margin-bottom: 18px;
    color: var(--ink-3);
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .chapter-lede {
    grid-column: 9 / span 4;
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.45;
    max-width: 38ch;
  }

  @media (max-width: 900px) {
    .chapter-head {
      grid-template-columns: 1fr;
    }

    .chapter-head > * {
      grid-column: 1 !important;
    }

    .chapter-lede {
      margin-top: 12px;
    }
  }

  .note {
    color: var(--ink-3);
    font-size: 14px;
    line-height: 1.5;
    max-width: 44ch;
  }

  /* ───── Planches ───── */
  .plate {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--bg);
  }

  .plate :global(picture),
  .plate :global(img),
  .plate canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .plate :global(img) {
    object-fit: cover;
  }

  .plate canvas {
    opacity: 0;
    pointer-events: none;
  }

  .plate:global(.is-ascii) canvas {
    opacity: 1;
  }

  .plate:global(.is-ascii) :global(img) {
    opacity: 0;
  }

  .plate:global(.is-developed) :global(img) {
    opacity: 1;
    transition: opacity 0.01s 0.05s;
  }

  .plate:global(.is-developed) canvas {
    -webkit-mask-image: linear-gradient(to bottom, transparent 40%, #000 60%);
    mask-image: linear-gradient(to bottom, transparent 40%, #000 60%);
    -webkit-mask-size: 100% 250%;
    mask-size: 100% 250%;
    -webkit-mask-position: 0 100%;
    mask-position: 0 100%;
    animation: develop 1.5s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }

  @keyframes develop {
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
      opacity: 1;
      visibility: hidden;
    }
  }

  .plate figcaption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    display: flex;
    gap: 14px;
    color: var(--ink-2);
    z-index: 1;
  }

  .plate figcaption span {
    color: var(--ink-4);
  }

  .spec {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .spec div {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }

  .spec dt {
    color: var(--ink-3);
  }

  .spec dd {
    margin: 0;
  }

  .spec small {
    display: block;
    font-size: inherit;
    color: var(--ink-3);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .spec-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0 var(--gap);
    margin-top: clamp(32px, 4vw, 56px);
  }

  .spec-row div {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  @media (max-width: 900px) {
    .board {
      grid-template-columns: 1fr;
    }

    .board > * {
      grid-column: 1 !important;
    }

    .board-square .spec {
      margin-top: 32px;
    }

    .spec-row {
      grid-template-columns: 1fr;
    }

    .spec-row div {
      grid-template-columns: 76px 1fr;
      gap: 12px;
    }
  }

  .lineage {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding: clamp(64px, 9vw, 128px) 0 clamp(80px, 11vw, 160px);
    align-items: end;
  }

  .errata-list h3,
  .lineage-text h3 {
    margin: 0 0 16px;
    font-weight: 400;
    color: var(--ink-3);
  }

  .errata-list ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .errata-list li {
    display: grid;
    grid-template-columns: 36px 1fr;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }

  .errata-list li span {
    color: var(--sig);
  }

  .lineage-text {
    grid-column: 1 / span 5;
  }

  .lineage-text p {
    margin: 0 0 16px;
    color: var(--ink-2);
    max-width: 46ch;
  }

  .plate-windings {
    grid-column: 7 / span 6;
    aspect-ratio: 1 / 1;
  }

  @media (max-width: 900px) {
    .lineage {
      grid-template-columns: 1fr;
    }

    .lineage > * {
      grid-column: 1 !important;
    }

    .plate-windings {
      margin: 0 calc(var(--m) * -1);
      aspect-ratio: 4 / 5;
    }

    .lineage .plate-windings {
      order: -1;
      margin-bottom: 32px;
    }
  }

  /* ───── Statut ───── */
  .matrix {
    border-top: 1px solid var(--line);
  }

  .m-row {
    display: grid;
    grid-template-columns: minmax(180px, 3fr) repeat(4, minmax(48px, 1fr)) minmax(160px, 3fr);
    gap: var(--gap);
    align-items: baseline;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }

  .m-group {
    border-top: 1px solid var(--ink-4);
  }

  .m-head {
    color: var(--ink-3);
  }

  .m-name {
    display: grid;
    grid-template-columns: 96px 1fr;
    white-space: nowrap;
  }

  .m-name i {
    font-style: normal;
    color: var(--ink-3);
    grid-column: 1;
  }

  .m-head span:first-child {
    padding-left: 96px;
  }

  .m-stage,
  .m-cell {
    text-align: center;
  }

  .m-cell {
    font-size: 14px;
    line-height: 1;
  }

  .v2 {
    color: var(--ink);
  }

  .v1 {
    color: var(--sig);
    font-size: 14px;
  }

  .v0 {
    color: var(--ink-4);
  }

  .m-row:not(.m-head) .m-note {
    color: var(--ink-3);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .legend {
    display: flex;
    gap: 28px;
    margin: 20px 0 clamp(96px, 13vw, 180px);
    color: var(--ink-3);
  }

  .legend b {
    font-weight: 400;
    margin-right: 8px;
  }

  @media (max-width: 760px) {
    .m-head {
      display: none;
    }

    .m-row {
      grid-template-columns: 1fr repeat(4, 14px);
      gap: 6px 12px;
      align-items: center;
    }

    .m-row > * {
      grid-row: 1;
    }

