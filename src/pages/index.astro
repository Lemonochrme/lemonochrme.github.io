---
import redline from '../../aerolith-galery/Lithframe_Bezier_01_Redline_4K.png';
import obsidian from '../../aerolith-galery/Lithframe_Bezier_02_Obsidian_4K.png';
import powertrain from '../../aerolith-galery/Lithframe_Bezier_03_Powertrain_4K.png';
import exploded from '../../aerolith-galery/Lithframe_Bezier_04_Exploded_4K.png';
import service from '../../aerolith-galery/Lithframe_Bezier_05_Service_4K.png';
import silhouette from '../../aerolith-galery/Lithframe_Bezier_06_Silhouette_4K.png';
import flightController from '../../aerolith-galery/Lithframe_Bezier_07_FC_4K.png';
import windings from '../../aerolith-galery/Lithframe_Bezier_08_Windings_4K.png';
import harness from '../../aerolith-galery/Lithframe_Bezier_09_Harness_4K.png';
import Default from '../layouts/Default.astro';

const renders = [
  { image: redline, title: 'Redline' },
  { image: obsidian, title: 'Obsidian' },
  { image: powertrain, title: 'Powertrain' },
  { image: exploded, title: 'Exploded view' },
  { image: service, title: 'Service access' },
  { image: silhouette, title: 'Silhouette' },
  { image: flightController, title: 'Flight controller' },
  { image: windings, title: 'Motor windings' },
  { image: harness, title: 'Wiring harness' },
];
---

<Default title="Home" isHome>
  <section class="aerolith-showcase" aria-label="Galerie des rendus Aerolith">
    <div class="gallery">
      {renders.map((render, index) => (
        <figure class="gallery-slide">
          <img
            src={render.image.src}
            alt={`Aerolith — ${render.title}`}
            fetchpriority={index === 0 ? 'high' : undefined}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </figure>
      ))}
    </div>

    <div class="hud" aria-hidden="true">
      <div class="hud-panel">
        <h1 class="hud-title" data-text="AEROLITH">AEROLITH</h1>
        <p class="hud-status"><span class="hud-typed">WORK IN PROGRESS</span><span class="hud-cursor"></span></p>
        <div class="hud-progress"><i></i></div>
      </div>
    </div>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="boot" aria-hidden="true"></div>
  </section>

  <style>
    .aerolith-showcase {
      position: relative;
      width: 100%;
      height: 100%;
    }

    .gallery {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      overflow-y: auto;
      overscroll-behavior-y: contain;
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
      scrollbar-width: thin;
      scrollbar-color: #fa5252 #080b10;
    }

    .gallery-slide {
      display: grid;
      flex: 0 0 100%;
      min-width: 100%;
      min-height: 100%;
      height: 100%;
      margin: 0;
      place-items: center;
      background: #080b10;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      overflow: hidden;
    }

    .gallery-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      animation: image-in 1.8s cubic-bezier(.2,.7,.2,1) both;
    }

    @keyframes image-in {
      from { transform: scale(1.12); filter: brightness(.2) saturate(.4); }
      to { transform: scale(1); filter: none; }
    }

    /* Overlay rétro-informatique */
    .hud {
      --hud: #ffb347;
      position: absolute;
      inset: 0;
      display: flex;
      align-items: flex-end;
      padding: clamp(1rem, 4vw, 3rem);
      pointer-events: none;
      font-family: ui-monospace, 'SFMono-Regular', 'Cascadia Mono', Menlo, Consolas, monospace;
      color: var(--hud);
      text-transform: uppercase;
      z-index: 2;
    }

    .hud-panel {
      padding: .9rem 1.1rem 1rem;
      border: 1px solid color-mix(in srgb, var(--hud) 55%, transparent);
      background: rgba(8, 11, 16, .55);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      text-shadow: 0 0 8px color-mix(in srgb, var(--hud) 60%, transparent);
      box-shadow: 0 0 24px rgba(0, 0, 0, .4), inset 0 0 18px rgba(255, 179, 71, .06);
      clip-path: inset(0 100% 0 0);
      animation: panel-in .7s steps(14) 1.1s forwards;
    }

    .hud-title {
      position: relative;
      margin: 0 0 .1rem;
      font-size: clamp(2rem, 9vw, 4.5rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: .12em;
      color: #fff4e0;
      animation: flicker 5s linear 2.2s infinite;
    }

    .hud-title::before,
    .hud-title::after {
      content: attr(data-text);
      position: absolute;
      inset: 0;
      opacity: .0;
    }

    .hud-title::before { color: #ff5c5c; animation: glitch-a 6s steps(1) 3s infinite; }
    .hud-title::after { color: #4fd8ff; animation: glitch-b 6s steps(1) 3s infinite; }

    .hud-status {
      display: flex;
      align-items: center;
      margin: 0;
      font-size: clamp(.75rem, 2.8vw, 1.05rem);
      letter-spacing: .3em;
    }

    .hud-typed {
      display: inline-block;
      overflow: hidden;
      white-space: nowrap;
      width: 0;
      animation: type 1.2s steps(16) 1.8s forwards;
    }

    .hud-cursor {
      width: .6em;
      height: 1em;
      margin-left: .2em;
      background: var(--hud);
      animation: blink .9s steps(1) infinite;
    }

    .hud-progress {
      height: 3px;
      margin-top: .7rem;
      background: rgba(255, 179, 71, .18);
      overflow: hidden;
    }

    .hud-progress i {
      display: block;
      width: 100%;
      height: 100%;
      background: repeating-linear-gradient(90deg, var(--hud) 0 6px, transparent 6px 9px);
      transform-origin: left;
      animation: progress 2.2s steps(22) 1.8s both, pulse 2.4s ease-in-out 4s infinite;
      --end: .62;
    }

    .scanlines {
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(0, 0, 0, .14) 0 1px, transparent 1px 3px);
      mix-blend-mode: multiply;
    }

    /* Rideau d'allumage CRT à l'arrivée */
    .boot {
      position: absolute;
      inset: 0;
      z-index: 4;
      pointer-events: none;
      background: #080b10;
      animation: boot 1.1s cubic-bezier(.7,0,.2,1) forwards;
    }

    @keyframes boot {
      0% { clip-path: inset(49.5% 0 49.5% 0); background: #fff4e0; opacity: 1; }
      35% { clip-path: inset(49.5% 0 49.5% 0); background: #fff4e0; opacity: 1; }
      100% { clip-path: inset(0 0 100% 0); background: #080b10; opacity: 0; }
    }

    @keyframes panel-in { to { clip-path: inset(0 0 0 0); } }
    @keyframes type { to { width: calc(16 * (1ch + .3em)); } }
    @keyframes progress { from { transform: scaleX(0); } to { transform: scaleX(var(--end)); } }
    @keyframes pulse { 50% { opacity: .55; } }
    @keyframes blink { 50% { opacity: 0; } }
    @keyframes flicker {
      0%, 94%, 100% { opacity: 1; }
      95% { opacity: .6; }
      96% { opacity: 1; }
      97% { opacity: .75; }
    }
    @keyframes glitch-a {
      0%, 92%, 100% { opacity: 0; transform: none; }
      93% { opacity: .8; transform: translate(-3px, 1px); clip-path: inset(10% 0 55% 0); }
      95% { opacity: .8; transform: translate(2px, -1px); clip-path: inset(60% 0 8% 0); }
    }
    @keyframes glitch-b {
      0%, 92%, 100% { opacity: 0; transform: none; }
      94% { opacity: .8; transform: translate(3px, -1px); clip-path: inset(40% 0 30% 0); }
      96% { opacity: .8; transform: translate(-2px, 1px); clip-path: inset(5% 0 70% 0); }
    }

    @media (max-width: 600px) {
      .hud { align-items: flex-end; padding: 1rem 1rem 4.5rem; }
      .hud-panel { width: 100%; }
    }

    @media (prefers-reduced-motion: reduce) {
      .gallery { scroll-behavior: auto; }
      .gallery-slide img, .hud-panel, .hud-typed, .hud-progress i, .boot,
      .hud-title, .hud-title::before, .hud-title::after { animation: none; }
      .hud-panel { clip-path: none; }
      .hud-typed { width: auto; }
      .hud-progress i { transform: scaleX(.62); }
      .boot { display: none; }
    }

  </style>

</Default>
