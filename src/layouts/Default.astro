---
import Head from '../components/Head.astro';
import Masthead from '../components/Masthead.astro';
import ThemeScript from '../components/ThemeScript.astro';
import '../styles/global.scss';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  isHome?: boolean;
}

const { title, description, image, isHome = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <ThemeScript />
  <Head title={title} description={description} image={image} />

  <body class={isHome ? 'home-page' : undefined} style="display: flex; flex-direction: column; min-height: 100vh; margin: 0;">
    {!isHome && (
      <>
      <script type="text/javascript" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
      <script is:inline>
        MathJax = {
          tex: {
            inlineMath: [['$', '$'], ['\\(', '\\)']],
            displayMath: [['$$', '$$'], ['\\[', '\\]']]
          }
        };
      </script>
      </>
    )}

    <div class:list={['container', 'content', { 'home-content': isHome }]} style="flex: 1;">
      {!isHome && <Masthead />}
      <main>
        <slot />
      </main>
    </div>

    {!isHome && (
      <div class="container">
        <footer>
          <small>
            &copy; {new Date().getFullYear()} Robin Marin-Muller
          </small>
        </footer>
      </div>
    )}
  </body>
  <style>
    .home-page {
      overflow: hidden;
      background: #080b10;
    }

    .home-content {
      width: 100%;
      max-width: none;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 0;
    }

    .home-content main {
      height: 100vh;
      height: 100dvh;
    }
  </style>
</html>
